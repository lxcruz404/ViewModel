<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml: la "ficha de presentación" de la app.
    Android lo lee para saber el nombre de la app y qué Activity abrir primero.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La aplicación: nombre visible y tema de la ventana. -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ViewModelFacil">

        <!--
            La única Activity de la app.
            No añadimos "configChanges": así, al girar el teléfono, Android
            vuelve a crear la Activity y podemos comprobar que el ViewModel
            conserva el contador.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Esto hace que la app aparezca en el menú del teléfono y se abra aquí. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
